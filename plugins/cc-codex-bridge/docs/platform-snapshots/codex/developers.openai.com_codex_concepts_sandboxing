    const normalizeSurfaceAnchors = (value) => {
      if (group !== "codex-surface" || !modeIds.includes(value)) return;

      root
        .querySelectorAll(
          "h2[id], h3[id], h4[id], h5[id], h6[id], [data-codex-legacy-anchor]"
